{
  "name": "lg-remote-card",
  "version": "v0.0.0-master",
  "description": "LG Remote card",
  "keywords": [
    "automation",
    "custom-cards",
    "hass",
    "home-assistant",
    "homeassistant",
    "lovelace"
  ],
  "license": "MIT",
  "author": "Maurizio <madmicio@tiscali.it>",
  "repository": "git@github.com:madmicio/LG-WebOS-Remote-Control.git",
  "module": "lg-remote-card.js",
  "scripts": {
    "start": "rolldown -c rolldown.config.ts --watch",
    "build": "npm run rolldown && npm run add-version",
    "add-version": "cross-var replace-in-file \"@LG_REMOTE_CONTROL_CARD_VERSION_PLACEHOLDER@\" \"$npm_package_version\" \"dist/lg-remote-control.js\"",
    "rolldown": "rolldown -c rolldown.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "home-assistant-js-websocket": "^9.1.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-proposal-decorators": "^7.23.6",
    "@babel/plugin-transform-runtime": "^7.23.6",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.10.5",
    "cross-var": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "replace-in-file": "^7.0.2",
    "rolldown": "1.2.6",
    "rollup-plugin-serve": "^3.0.0",
    "ts-lit-plugin": "^2.0.1",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
