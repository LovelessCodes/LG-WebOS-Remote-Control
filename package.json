{
  "name": "lg-remote-card",
  "version": "v0.0.0-master",
  "description": "LG Remote card",
  "keywords": [
    "automation",
    "custom-cards",
    "hass",
    "home-assistant",
    "homeassistant",
    "lovelace"
  ],
  "license": "MIT",
  "author": "Maurizio <madmicio@tiscali.it>",
  "repository": "git@github.com:madmicio/LG-WebOS-Remote-Control.git",
  "module": "lg-remote-card.js",
  "scripts": {
    "start": "rolldown -c rolldown.config.ts --watch",
    "build": "npm run rolldown && npm run add-version",
    "add-version": "cross-var replace-in-file \"@LG_REMOTE_CONTROL_CARD_VERSION_PLACEHOLDER@\" \"$npm_package_version\" \"dist/lg-remote-control.js\"",
    "rolldown": "rolldown -c rolldown.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "home-assistant-js-websocket": "^9.6.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "cross-var": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "replace-in-file": "^9.0.0",
    "rolldown": "1.2.6",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
